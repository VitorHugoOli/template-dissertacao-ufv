\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{abntex2-UFV}[2026/11/11 v0.2 AbnTeX2-UFV (modified)]

% Margens: 3 cm superior e esquerda, 2 cm inferior e direita
\setlrmarginsandblock{3cm}{2cm}{*}
\setulmarginsandblock{3cm}{2cm}{*}
\checkandfixthelayout

% Recuo da primeira linha e espaço entre parágrafos
\setlength{\parindent}{1.3cm}
\setlength{\parskip}{0.2cm}

\providecommand{\imprimircampus}{}
\newcommand{\campus}[1]{\renewcommand{\imprimircampus}{#1}}

\providecommand{\imprimircurso}{}
\newcommand{\curso}[1]{\renewcommand{\imprimircurso}{#1}}

% Capa
\makeatletter
\renewcommand{\imprimircapa}{%
  \begin{capa}%
    \center
    {\large \MakeUppercase{\imprimirinstituicao}}
    \par
    {\large \MakeUppercase{\imprimircampus}}
    \par
    \abntex@ifnotempty{\imprimircurso}{%
       {\large \MakeUppercase{\imprimircurso}}
    }%
    \vspace*{3cm}
    {\large \MakeUppercase{\imprimirautor}}
    \vspace*{\fill}
    {\bfseries\large \MakeUppercase{\imprimirtitulo}}
    \vspace*{\fill}
    \par
    {\large\MakeUppercase{\imprimirlocal}}
    \par
    {\large\imprimirdata}
    \vspace*{1cm}
  \end{capa}
}

% Folha de rosto
\renewcommand{\folhaderostocontent}{
\begin{center}
{\large\MakeUppercase{\imprimirautor}}

\vspace*{\fill}\vspace*{\fill}
\par
{\large\SingleSpacing\MakeUppercase{\imprimirtitulo}}
\par

\vspace*{\fill}

\abntex@ifnotempty{\imprimirpreambulo}{%
  \hspace{.45\textwidth}
  \begin{minipage}{.5\textwidth}
  \SingleSpacing
  \imprimirpreambulo

  \bigskip
  % O rótulo segue o idioma do documento ("Orientador:" ou "Supervisor:")
  {\imprimirorientadorRotulo~\imprimirorientador\par}

  \smallskip
  \abntex@ifnotempty{\imprimircoorientador}{%
    {\imprimircoorientadorRotulo~\imprimircoorientador}%
  }%
  \end{minipage}%
  \vspace*{\fill}
}%

\vspace{1cm}
    \vspace*{\fill}
    \par
    {\large\MakeUppercase{\imprimirlocal}}
    \par
    \vspace{-0.2cm}
    {\large\imprimirdata}
    \vspace*{1cm}
\end{center}
}
\makeatother

\renewcommand{\imprimirorientadorRotulo}{\orientadorname}
